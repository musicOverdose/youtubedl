# =====================================================================
# Telegram YouTube Downloader - Environment Configuration
# =====================================================================

# Telegram Bot API Mode
# Options: 'local' (Production standard - enables up to 2000MB uploads with zero-multipart local handoff)
#          'cloud' (Fallback mode - strictly limited to 50MB uploads via official api.telegram.org)
TELEGRAM_API_MODE=local

# Note: Telegram Bot credentials (BOT_TOKEN, TELEGRAM_API_ID, TELEGRAM_API_HASH)
# are securely managed and encrypted via the Web Admin Panel. Initial/bootstrap
# values may optionally be seeded or configured directly through Web Admin.
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram API Base URL
# For self-hosted Local Bot API server (enables up to 2000MB uploads): http://telegram-bot-api:8081
# For official cloud Bot API (limited to 50MB): https://api.telegram.org
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081

# Private Telegram Cache Channel ID (e.g. -1001234567890)
# Note: Bot MUST be added as an Administrator in this channel with post permissions!
TELEGRAM_CACHE_CHANNEL_ID=-1001234567890

# Database & Redis URLs (Internal Docker network hosts)
DATABASE_URL=postgresql+asyncpg://ytdl_user:ytdl_secure_pass@postgres:5432/ytdl_db
REDIS_URL=redis://redis:6379/0

# Web Admin Panel Configuration
# Host port mapping for Web Admin (defaults to 8087 on host, targeting container port 8080)
WEB_HOST_PORT=8087
ADMIN_USERNAME=admin
# Initial admin password for bootstrap (required on fresh install if ADMIN_PASSWORD_HASH is empty)
ADMIN_PASSWORD=ChangeThisSecureAdminPassword123!
# Or provide precomputed Argon2id password hash:
ADMIN_PASSWORD_HASH=
# Set to 'true' only when intentionally resetting the database-stored admin password on container startup
ADMIN_PASSWORD_RESET=false
SECRET_KEY=change_this_to_a_random_secret_string_for_session_cookies_64chars

# Resource & Concurrency Controls (Optimized for 2 CPU cores / 4 GB RAM)
MAX_ACTIVE_JOBS=1
MAX_CONCURRENT_PER_USER=1
MAX_TEMP_STORAGE_GB=30
MAX_UPLOAD_SIZE_MB=2000

# Download & Duration Controls
MAX_VIDEO_DURATION_SECONDS=7200
ALLOW_UNKNOWN_DURATION=false
CACHE_HIT_BYPASSES_DURATION_LIMIT=true
DEFAULT_MAX_HEIGHT=1080
PLAYLISTS_ENABLED=false

# Media Formats Enabled
H264_ENABLED=true
H265_ENABLED=true
MP3_ENABLED=true
SUBTITLES_ENABLED=true

# AI Translation (OpenAI-compatible: OpenAI, Groq, Ollama, OpenRouter, etc.)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_CHUNKS=20

# yt-dlp & Network Options
YTDLP_PROXY=
YTDLP_COOKIES_FILE=/config/secrets/youtube-cookies.txt

# Logging
LOG_LEVEL=INFO
